{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "web",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "web", "run", "dev"],
      "port": 5173
    },
    {
      "name": "api",
      "runtimeExecutable": "uv",
      "runtimeArgs": ["run", "python", "run.py"],
      "port": 8000,
      "env": {
        "KINETIC_PUBLIC_ORIGIN": "http://localhost:5173",
        "KINETIC_ALLOW_INSECURE_HTTP": "1"
      }
    }
  ]
}
