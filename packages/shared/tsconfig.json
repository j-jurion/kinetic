{
  // Type-checks the tests and the modules they import (the chart modules need Plotly's types,
  // which only the apps install, so they are checked by the apps instead).
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "verbatimModuleSyntax": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true
  },
  "include": ["test", "vitest.config.ts"]
}
